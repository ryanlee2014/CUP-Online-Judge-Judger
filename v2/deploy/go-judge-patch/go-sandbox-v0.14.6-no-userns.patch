+++ b/container/container_init_linux.go	2026-11-26 10:30:49.063582575 +0400
@@ -324,6 +324,11 @@
 func initFileSystem(c containerConfig) error {
 	// mount tmpfs as root
 	const tmpfs = "tmpfs"
+	// KeyClaw: without a user namespace the new mount namespace inherits shared
+	// propagation from the host (systemd), which makes pivot_root fail with EINVAL.
+	if err := syscall.Mount("", "/", "", syscall.MS_REC|syscall.MS_PRIVATE, ""); err != nil {
+		return fmt.Errorf("init_fs: make / private: %w", err)
+	}
 	if err := syscall.Mount(tmpfs, c.ContainerRoot, tmpfs, 0, ""); err != nil {
 		return fmt.Errorf("init_fs: mount /: %w", err)
 	}
